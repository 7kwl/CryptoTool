<!-- ============================================================================
     AliyunIcons.xaml : 阿里云矢量图标资源字典
     ============================================================================
     从 App.xaml 移出:iconfont.ttf 字体族 + 5 个彩色 DrawingImage 图标。
     任何界面(ECDSA 各页、文件签名、批量任务等)只需在自身 XAML 或 App 资源里
     合并本字典,即可通过 {StaticResource IconXxx} 直接引用,key 与原定义完全一致:

       IconfontFamily  -> 阿里云 iconfont 字体族(单色字体方式,textBlock.FontFamily)
       IconCopy        -> 复制
       IconPaste       -> 粘贴
       IconClear       -> 清除/清空
       IconImport      -> 导入
       IconExport      -> 导出
       IconJiami       -> 加密锁（icon-jiami，曲线分类统一图标）
       ============================================================================ -->
       <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

       <!-- 阿里云矢量图标库：iconfont.ttf 嵌入为程序集资源（单色字体方式） -->
       <FontFamily x:Key="IconfontFamily">/WpfApp1;component/font/font_5223423_y4fg39ohqqs/iconfont.ttf#iconfont</FontFamily>

       <!-- 加密锁（icon-jiami，取自 font/font_5223423_y4fg39ohqqs）—— 曲线分类统一图标 -->
       <!-- 加密锁（icon-jiami，取自 font/font_5223423_y4fg39ohqqs）—— 曲线分类统一图标。
            注意：iconfont 字体 glyph 的坐标系 y 轴向上，而 WPF GeometryDrawing 使用屏幕坐标系 y 轴向下，
            因此需对 DrawingGroup 做垂直翻转，使图标正立显示。 -->
       <DrawingImage x:Key="IconJiami">
         <DrawingImage.Drawing>
             <DrawingGroup>
                 <DrawingGroup.Transform>
                     <ScaleTransform ScaleX="1" ScaleY="-1" CenterX="512" CenterY="512"/>
                 </DrawingGroup.Transform>
