<!--
    EcdsaTopPanel.xaml — ECDSA 主页（密钥生成 + 密钥操作）
    整体布局：两列（50% / 50%）
      ├─ 左列：密钥生成（私钥 / 公钥，各带复制/粘贴/导入/保存/清空操作）
      └─ 右列：密钥操作（生成/验证/提取等按钮 + 输出格式/存储标准/曲线设置 + 结果区）
-->
<UserControl x:Class="WpfApp1.ECDSA.EcdsaTopPanel.EcdsaTopPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="1800"
             Background="White">

    <!-- ===== 根网格：两列 ===== -->
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600"/>
            <!-- 左列：密钥生成 -->
            <ColumnDefinition Width="*"/>
            <!-- 右列：密钥操作 -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 左列：密钥生成 ==================== -->
        <GroupBox Grid.Row="0" Grid.Column="0" Margin="3">
            <GroupBox.Header>
                <TextBlock Text="密钥生成" HorizontalAlignment="Stretch" TextAlignment="Center"/>
            </GroupBox.Header>
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- 文本框 -->
                    <ColumnDefinition Width="100"/>
                    <!-- 操作按钮 -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <!-- 私钥区 -->
                <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Margin="0,0,6,6">
                    <TextBox x:Name="textPrivateKey" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="私钥 (PEM)" Margin="0,4,6,0" Foreground="#FF333333" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
                <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="6,0,0,6">
                    <TextBlock Text="&#x1F511; 私钥操作" FontWeight="Bold" Foreground="#FFC00000" Margin="0,0,0,4" TextAlignment="Center"/>
                    <Button x:Name="btnCopyPrivateKey" Content="复制私钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnPastePrivateKey" Content="粘贴私钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnImportPrivateKey" Content="导入私钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnSavePrivateKey" Content="保存私钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnClearPrivateKey" Content="清空私钥" Height="30" Margin="0,2"/>
                </StackPanel>

                <!-- 公钥区 -->
                <Grid Grid.Row="2" Grid.Column="0" Grid.RowSpan="2" Margin="0,6,6,0">
                    <TextBox x:Name="textPublicKey" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="公钥 (PEM)" Margin="0,4,6,0" Foreground="#FF333333" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" Margin="6,6,0,0">
                    <TextBlock Text="&#x1F513; 公钥操作" FontWeight="Bold" Foreground="#FF0064B4" Margin="0,0,0,4" TextAlignment="Center"/>
                    <Button x:Name="btnCopyPublicKey" Content="复制公钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnPastePublicKey" Content="粘贴公钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnImportPublicKey" Content="导入公钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnSavePublicKey" Content="保存公钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnClearPublicKey" Content="清空公钥" Height="30" Margin="0,2"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ==================== 右列：密钥操作 ==================== -->
        <GroupBox Grid.Row="0" Grid.Column="1" Margin="3">
            <GroupBox.Header>
                <TextBlock Text="密钥操作" HorizontalAlignment="Stretch" TextAlignment="Center"/>
            </GroupBox.Header>
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*"/>
                    <!-- 上：操作区（占 50%） -->
                    <RowDefinition Height="0.5*"/>
                    <!-- 中：结果区（计算结果 + 运行结果，占 50%） -->
                </Grid.RowDefinitions>

                <!-- 上：操作区（左按钮 + 右设置），5 行一一对应保证行对齐 -->
                <Grid x:Name="gridKeyOperations" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <!-- 操作按钮 -->
                        <ColumnDefinition Width="*"/>
                        <!-- 设置项 -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>

                    <!-- 第 1 行：生成密钥对 / 输出格式 -->
                    <Button x:Name="btnGenerateKeyPair" Content="生成密钥对" Grid.Row="0" Grid.Column="0" Height="30" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="输出格式：" Width="90" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="comboOutputFormat" Width="150" IsReadOnly="True" VerticalAlignment="Center">
                            <ComboBoxItem Content="PEM"/>
                            <ComboBoxItem Content="Base64"/>
                            <ComboBoxItem Content="Hex大写"/>
                            <ComboBoxItem Content="Hex小写"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 第 2 行：验证密钥对 / 密钥类型 + 转换 -->
                    <Button x:Name="btnValidateKeyPair" Content="验证密钥对" Grid.Row="1" Grid.Column="0" Height="30" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="密钥类型：" Width="90" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <RadioButton x:Name="radioPrivateKey" Content="私钥" IsChecked="True" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <RadioButton x:Name="radioPublicKey" Content="公钥" VerticalAlignment="Center"/>
                        <Button x:Name="btnConvertKey" Content="转换" Width="80" Height="26" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 第 3 行：从私钥提取公钥 / 私钥存储标准 + 转换 -->
                    <Button x:Name="btnGetPublicKeyFromPrivate" Content="从私钥提取公钥" Grid.Row="2" Grid.Column="0" Height="30" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="私钥存储标准：" Width="90" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="comboPrivateKeyStandard" Width="260" IsReadOnly="True" VerticalAlignment="Center">
                            <ComboBoxItem Content="SEC1 / RFC 5915（短编码 / namedCurve）"/>
                            <ComboBoxItem Content="SEC1/RFC 5915（长编码 / specifiedCurve）"/>
                        </ComboBox>
                        <Button x:Name="btnConvertPrivateKeyStandard" Content="转换" Width="80" Height="26" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 第 4 行：获取私钥曲线类型 / 公钥存储标准 + 转换 -->
                    <Button x:Name="btnGetCurveType" Content="获取私钥曲线类型" Grid.Row="3" Grid.Column="0" Height="30" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="公钥存储标准：" Width="90" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="comboPublicKeyStandard" Width="260" IsReadOnly="True" VerticalAlignment="Center">
                            <ComboBoxItem Content="RFC 5480/namedCurve"/>
                            <ComboBoxItem Content="RFC 5480/specifiedCurve"/>
                        </ComboBox>
                        <Button x:Name="btnConvertPublicKeyStandard" Content="转换" Width="80" Height="26" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 第 5 行：清空全部 / 曲线类别 → 曲线 -->
                    <Button x:Name="btnClearAll" Content="清空全部" Grid.Row="4" Grid.Column="0" Height="30" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="曲线类别：" Width="90" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="comboCategory" Width="120" IsReadOnly="True" VerticalAlignment="Center"/>
                        <TextBlock Text="→" VerticalAlignment="Center" Margin="4,0" FontSize="16" FontWeight="Bold"/>
                        <ComboBox x:Name="comboCurve" Width="260" IsReadOnly="True" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 中：计算结果（RichTextBox 支持彩色运行日志） -->
                <GroupBox Grid.Row="1" Grid.Column="0" Header="计算结果" Margin="0,6,3,0">
                    <RichTextBox x:Name="textKeyResult" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="White" BorderThickness="0" FontFamily="Consolas" FontSize="12" MinHeight="100"/>
                </GroupBox>

                <!-- 中：运行结果（RichTextBox 支持彩色运行日志） -->
                <GroupBox Grid.Row="1" Grid.Column="1" Header="运行结果" Margin="3,6,0,0">
                    <RichTextBox x:Name="labelValidationResult" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="White" BorderThickness="0" FontFamily="Consolas" FontSize="12" MinHeight="100"/>
                </GroupBox>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
