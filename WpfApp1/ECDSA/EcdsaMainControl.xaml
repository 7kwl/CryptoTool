<UserControl x:Class="WpfApp1.ECDSA.EcdsaMainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mainControl="clr-namespace:WpfApp1.ECDSA.EcdsaTopPanel"
             xmlns:tabControl="clr-namespace:WpfApp1.ECDSA.EcdsaTabControl"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="1800"
             Background="White">
    <UserControl.Resources>
        <!-- 二级导航按钮样式（NavButtonStyle）：控制"密钥生成 / ECDH加密解密 / ECIES签名验签 / 文件签名验签"四个 ToggleButton 的外观。
             默认（未选中）：灰底黑字；悬停：蓝底白字；选中：紫底白字。 -->
        <Style x:Key="NavButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#FF9E9E9E"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI Light"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2196F3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FF4B1C83"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 内容区域1 -->
        <mainControl:EcdsaTopPanel x:Name="TopPanel" Grid.Row="0" Margin="1,1,1,1" Loaded="EcdsaTopPanel_Loaded"/>
        <!-- 二级菜单栏 -->
        <Border Grid.Row="1" BorderBrush="#d742c50e" BorderThickness="0,0,0,1" Margin="1,1,1,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0">
                <ToggleButton x:Name="BtnKeyGen" Style="{StaticResource NavButtonStyle}" Content="ECDH加密解密" Click="SubNavButton_Click" Tag="KeyGen"/>
                <ToggleButton x:Name="BtnEcdh" Style="{StaticResource NavButtonStyle}" Content="ECIES签名验签" Click="SubNavButton_Click" Tag="Ecdh"/>
                <ToggleButton x:Name="BtnEcies" Style="{StaticResource NavButtonStyle}" Content="ECIES加密解密" Click="SubNavButton_Click" Tag="Ecies"/>
                <ToggleButton x:Name="BtnFileSign" Style="{StaticResource NavButtonStyle}" Content="文件签名/验签" Click="SubNavButton_Click" Tag="FileSign"/>
            </StackPanel>
        </Border>
        <!-- 内容区域2 -->
        <tabControl:EcdsaTabPage x:Name="TabHost" Grid.Row="2" Margin="1,1,1,1"/>
    </Grid>
</UserControl>
