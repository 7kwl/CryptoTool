<UserControl x:Class="WpfApp1.ECDSA.MainControl.EcdsaMainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="1800"
             Background="White">

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Grid.Column="0" Header="密钥生成" Margin="3">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Margin="0,0,6,6">
                    <TextBox x:Name="textPrivateKey"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Stretch"
                             BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12"
                             Padding="4,22,4,4"/>
                    <TextBlock Text="私钥 (PEM)" Margin="0,4,6,0"
                               Foreground="#FF333333"
                               HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>

                <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="6,0,0,6">
                    <TextBlock Text="&#x1F511; 私钥操作" FontWeight="Bold" Foreground="#FFC00000"
                               Margin="0,0,0,4" TextAlignment="Center"/>
                    <Button x:Name="btnCopyPrivateKey" Content="复制私钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnPastePrivateKey" Content="粘贴私钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnImportPrivateKey" Content="导入私钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnSavePrivateKey" Content="保存私钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnClearPrivateKey" Content="清空私钥" Height="30" Margin="0,2"/>
                </StackPanel>

                <Grid Grid.Row="2" Grid.Column="0" Grid.RowSpan="2" Margin="0,6,6,0">
                    <TextBox x:Name="textPublicKey"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Stretch"
                             BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12"
                             Padding="4,22,4,4"/>
                    <TextBlock Text="公钥 (PEM)" Margin="0,4,6,0"
                               Foreground="#FF333333"
                               HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>

                <StackPanel Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" Margin="6,6,0,0">
                    <TextBlock Text="&#x1F513; 公钥操作" FontWeight="Bold" Foreground="#FF0064B4"
                               Margin="0,0,0,4" TextAlignment="Center"/>
                    <Button x:Name="btnCopyPublicKey" Content="复制公钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnPastePublicKey" Content="粘贴公钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnImportPublicKey" Content="导入公钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnSavePublicKey" Content="保存公钥" Height="30" Margin="0,2"/>
                    <Button x:Name="btnClearPublicKey" Content="清空公钥" Height="30" Margin="0,2"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="0" Grid.Column="1" Header="密钥操作" Margin="3">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <Button x:Name="btnGenerateKeyPair" Content="生成密钥对" Height="30" Margin="0,0,6,3"/>
                        <Button x:Name="btnValidateKeyPair" Content="验证密钥对" Height="30" Margin="0,3,6,3"/>
                        <Button x:Name="btnGetPublicKeyFromPrivate" Content="从私钥提取公钥" Height="30" Margin="0,3,6,3"/>
                        <Button x:Name="btnGetCurveType" Content="获取私钥曲线类型" Height="30" Margin="0,3,6,3"/>
                        <Button x:Name="btnClearAll" Content="清空全部" Height="30" Margin="0,3,6,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="输出格式：" Width="150" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="comboOutputFormat" Width="150" IsReadOnly="True"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="PEM"/>
                                <ComboBoxItem Content="Base64"/>
                                <ComboBoxItem Content="Hex大写"/>
                                <ComboBoxItem Content="Hex小写"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="密钥类型：" Width="150" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <RadioButton x:Name="radioPrivateKey" Content="私钥" IsChecked="True"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <RadioButton x:Name="radioPublicKey" Content="公钥"
                                         VerticalAlignment="Center"/>
                            <Button x:Name="btnConvertKey" Content="转换" Width="80" Height="26"
                                    Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="私钥存储标准：" Width="150" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="comboPrivateKeyStandard" Width="150" IsReadOnly="True"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="SEC1 (BEGIN EC PRIVATE KEY)"/>
                                <ComboBoxItem Content="PKCS#8 (BEGIN PRIVATE KEY)"/>
                            </ComboBox>
                            <Button x:Name="btnConvertPrivateKeyStandard" Content="转换" Width="80" Height="26"
                                    Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="公钥存储标准：" Width="150" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="comboPublicKeyStandard" Width="150" IsReadOnly="True"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="RFC 5480 namedCurve"/>
                                <ComboBoxItem Content="RFC 5480 specifiedCurve"/>
                            </ComboBox>
                            <Button x:Name="btnConvertPublicKeyStandard" Content="转换" Width="80" Height="26"
                                    Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock Text="曲线类别：" Width="150" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="comboCategory" Width="120" IsReadOnly="True"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="→" VerticalAlignment="Center" Margin="4,0"
                                       FontSize="16" FontWeight="Bold"/>
                            <ComboBox x:Name="comboCurve" Width="160" IsReadOnly="True"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <GroupBox Grid.Row="1" Grid.Column="0" Header="计算结果" Margin="0,6,3,0">
                    <TextBox x:Name="textKeyResult" IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Background="White" BorderThickness="0"
                             Text="从私钥提取/曲线检测：&#x0A;等待操作..."/>
                </GroupBox>

                <GroupBox Grid.Row="1" Grid.Column="1" Header="运行结果" Margin="3,6,0,0">
                    <TextBox x:Name="labelValidationResult" IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Background="White" BorderThickness="0" Foreground="Gray"
                             Text="验证结果: 未验证"/>
                </GroupBox>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
