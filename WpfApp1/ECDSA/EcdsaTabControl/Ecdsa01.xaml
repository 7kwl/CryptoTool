<!--
    Ecdsa01.xaml — ECDH 密钥交换页面（对应 WinForms 的 ECDSA01 视图）
    整体布局：三列（30% / 20% / 50%）两行（50% / 50%）
      ├─ 左列：爱丽丝 / 鲍勃 两把密钥对（私钥 + 公钥，PEM 文本框）
      ├─ 中列：ECDH 加密/解密（明文 / 密文 / 共享密钥 / IV，各带复制/粘贴按钮）
      └─ 右列：密钥操作（生成/加解密按钮 + 编码标准/曲线/模型等设置）
-->
<UserControl x:Class="WpfApp1.ECDSA.EcdsaTabControl.Ecdsa01"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="1800"
             Background="White">

    <!-- ===== 根网格：三列两行 ===== -->
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*"/> <!-- 左列：密钥对 -->
            <ColumnDefinition Width="20*"/> <!-- 中列：加密/解密 -->
            <ColumnDefinition Width="50*"/> <!-- 右列：密钥操作 -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 左列：爱丽丝 / 鲍勃 密钥对 ==================== -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="50*"/>
            </Grid.RowDefinitions>

            <!-- 爱丽丝的钥匙 -->
            <GroupBox Grid.Row="0" Header="爱丽丝的钥匙 (Alice)" MinHeight="220" Margin="0,0,0,2">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/> <!-- 私钥 -->
                        <ColumnDefinition Width="50*"/> <!-- 公钥 -->
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,4,0">
                        <TextBox x:Name="textEcdhAlicePrivate" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                        <TextBlock Text="私钥 (PEM)：" Margin="0,4,6,0" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid Grid.Column="1" Margin="4,0,0,0">
                        <TextBox x:Name="textEcdhAlicePublic" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                        <TextBlock Text="公钥 (PEM)：" Margin="0,4,6,0" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- 鲍勃的钥匙 -->
            <GroupBox Grid.Row="1" Header="鲍勃的钥匙 (Bob)" MinHeight="220" Margin="0,2,0,0">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/> <!-- 私钥 -->
                        <ColumnDefinition Width="50*"/> <!-- 公钥 -->
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,4,0">
                        <TextBox x:Name="textEcdhBobPrivate" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                        <TextBlock Text="私钥 (PEM)：" Margin="0,4,6,0" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid Grid.Column="1" Margin="4,0,0,0">
                        <TextBox x:Name="textEcdhBobPublic" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                        <TextBlock Text="公钥 (PEM)：" Margin="0,4,6,0" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ==================== 中列：ECDH 加密 / 解密 ==================== -->
        <GroupBox Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Header="ECDH 加密 / 解密（执行标准右边自行选择）" Margin="2,0,2,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>  <!-- 文本框 -->
                    <ColumnDefinition Width="80"/>  <!-- 复制/粘贴按钮 -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!-- 4 组：标签(22) + 文本框(25*) 交替 -->
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="25*"/>
                </Grid.RowDefinitions>

                <!-- 明文 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="明文:" VerticalAlignment="Center"/>
                <TextBox x:Name="textEcdhInput" Grid.Row="1" Grid.Column="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="4,0,0,0">
                    <Button Content="复制" Foreground="Red" Margin="0,1"/>
                    <Button Content="粘贴" Foreground="Red" Margin="0,1"/>
                </StackPanel>

                <!-- 密文 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="密文（可编辑）:" VerticalAlignment="Center"/>
                <TextBox x:Name="textEcdhOutput" Grid.Row="3" Grid.Column="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" Margin="4,0,0,0">
                    <Button Content="复制" Foreground="Red" Margin="0,1"/>
                    <Button Content="粘贴" Foreground="Red" Margin="0,1"/>
                </StackPanel>

                <!-- 共享密钥 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="共享密钥 (Base64, 可编辑):" VerticalAlignment="Center"/>
                <TextBox x:Name="textEcdhSharedKey" Grid.Row="5" Grid.Column="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Grid.RowSpan="2" Margin="4,0,0,0">
                    <Button Content="复制" Foreground="Red" Margin="0,1"/>
                    <Button Content="粘贴" Foreground="Red" Margin="0,1"/>
                </StackPanel>

                <!-- IV -->
                <TextBlock Grid.Row="6" Grid.Column="0" x:Name="lblEcdhIV" Text="IV (Base64，可编辑/留空随机):" VerticalAlignment="Center"/>
                <TextBox x:Name="textEcdhIV" Grid.Row="7" Grid.Column="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Grid.RowSpan="2" Margin="4,0,0,0">
                    <Button Content="复制" Foreground="Red" Margin="0,1"/>
                    <Button Content="粘贴" Foreground="Red" Margin="0,1"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ==================== 右列：密钥操作 ==================== -->
        <GroupBox Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Margin="4,0,0,0">
            <GroupBox.Header>
                <TextBlock Text="密钥操作" HorizontalAlignment="Stretch" TextAlignment="Center"/>
            </GroupBox.Header>
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/> <!-- 左：操作按钮 -->
                    <ColumnDefinition Width="*"/>   <!-- 右：参数设置 -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!-- 5 行设置项（各 32 高）+ 2 行弹性空间 -->
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="50*"/>
                    <RowDefinition Height="50*"/>
                </Grid.RowDefinitions>

                <!-- 左列：8 个操作按钮，各占 32 高的行，按钮本身 30 高并垂直居中 -->
                <Grid Grid.Column="0" Grid.RowSpan="7" Margin="0,0,5,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/> <!-- 吸收剩余空间 -->
                    </Grid.RowDefinitions>
                    <Button x:Name="btnGenerateEcdhKeys" Content="生成 EC 密钥对" Grid.Row="0" Height="30" VerticalAlignment="Center" Margin="0,0"/>
                    <Button x:Name="btnEcdhEncrypt" Content="加密" Grid.Row="1" Height="30" VerticalAlignment="Center" Margin="0,0"/>
                    <Button x:Name="btnEcdhDecrypt" Content="解密" Grid.Row="2" Height="30" VerticalAlignment="Center" Margin="0,0"/>
                    <Button x:Name="btnEcdhCopyResult" Content="复制结果" Grid.Row="3" Height="30" VerticalAlignment="Center" Margin="0,0"/>
                    <Button x:Name="btnEcdhPasteInput" Content="粘贴输入" Grid.Row="4" Height="30" VerticalAlignment="Center" Margin="0,0"/>
                    <Button x:Name="btnEcdhClear" Content="清空" Grid.Row="5" Height="30" VerticalAlignment="Center" Margin="0,0"/>
                    <Button x:Name="btnEcdhAliceCurve" Content="私钥1曲线" Grid.Row="6" Height="30" VerticalAlignment="Center" Margin="0,0"/>
                    <Button x:Name="btnEcdhBobCurve" Content="私钥2曲线" Grid.Row="7" Height="30" VerticalAlignment="Center" Margin="0,0"/>
                </Grid>

                <!-- 右列：第 1 行 —— 私钥编码标准 -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="私钥编码标准2：" Width="90" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="comboEcdhPrivateKeyStandard" Width="300" IsReadOnly="True" VerticalAlignment="Center"/>
                    <Button x:Name="btnConvertEcdhPrivateKeyStandard" Content="转换" Width="60" Height="24" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右列：第 2 行 —— 公钥编码标准 -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="公钥编码标准2：" Width="90" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="comboEcdhPublicKeyStandard" Width="300" IsReadOnly="True" VerticalAlignment="Center"/>
                    <Button x:Name="btnConvertEcdhPublicKeyStandard" Content="转换" Width="60" Height="24" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右列：第 3 行 —— 椭圆曲线（类别 → 曲线） -->
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="椭圆曲线：" Width="90" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="comboEcdhCategory" Width="183" IsReadOnly="True" VerticalAlignment="Center"/>
                    <TextBlock Text="→" Width="36" TextAlignment="Center" FontSize="16" VerticalAlignment="Center" Margin="4,0"/>
                    <ComboBox x:Name="comboEcdhCurve" Width="330" IsReadOnly="True" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右列：第 4 行 —— 密钥模型 -->
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="密钥模型：" Width="90" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="comboEcdhMode" Width="160" IsReadOnly="True" VerticalAlignment="Center">
                        <ComboBoxItem Content="8gwifi.org"/>
                        <ComboBoxItem Content="CryptoTool"/>
                        <ComboBoxItem Content="ANSI X9.63"/>
                        <ComboBoxItem Content="IEEE 1363a"/>
                        <ComboBoxItem Content="ISO/IEC 18033-2"/>
                        <ComboBoxItem Content="SECG SEC 1"/>
                    </ComboBox>
                </StackPanel>

                <!-- 右列：第 5 行 —— 明文编码 -->
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="明文编码：" Width="90" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="comboEcdhEncoding" Width="120" IsReadOnly="True" VerticalAlignment="Center">
                        <ComboBoxItem Content="UTF-8"/>
                        <ComboBoxItem Content="GBK (GB2312)"/>
                        <ComboBoxItem Content="Unicode (UTF-16 LE)"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
