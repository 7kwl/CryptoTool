<!--
    Ecdsa03.xaml — ECIES 加密解密页面（对应 WinForms 的 ECDSA03 视图）
    整体布局：三列（30% / 20% / 50%）
      ├─ 左列：加密 / 解密输入输出区（明文 / 密文 / 临时私钥 ePriv / 临时公钥 ePub）
      ├─ 中列：参数区（对称密钥 / IV / Bob 公钥 / 测试）
      └─ 右列：操作与配置区（加解密按钮 + 加密模式/格式/临时密钥转换等设置）
-->
<UserControl x:Class="WpfApp1.ECDSA.EcdsaTabControl.Ecdsa03"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfApp1.ECDSA.EcdsaTabControl"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="1800"
             Background="White">

    <!-- ===== 根网格：三列 ===== -->
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*"/> <!-- 左列：加密/解密输入输出 -->
            <ColumnDefinition Width="20*"/> <!-- 中列：参数 -->
            <ColumnDefinition Width="50*"/> <!-- 右列：操作与配置 -->
        </Grid.ColumnDefinitions>

        <!-- ==================== 左列：加密 / 解密输入输出 ==================== -->
        <GroupBox Grid.Column="0" Header="加密 / 解密" Margin="0,0,2,0">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>  <!-- 文本框 -->
                    <ColumnDefinition Width="28"/> <!-- 图标列（在 TextBox 外面右侧） -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="25*"/>
                </Grid.RowDefinitions>

                <!-- 明文输入 -->
                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,4,2">
                    <TextBox x:Name="textEncInput" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="明文输入：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,2,2,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image x:Name="imgCopyEncInput" Source="{StaticResource IconCopy}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="复制明文输入"/>
                    <Image x:Name="imgPasteEncInput" Source="{StaticResource IconPaste}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="粘贴明文输入"/>
                    <Image x:Name="imgClearEncInput" Source="{StaticResource IconClear}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="清空明文输入"/>
                </StackPanel>

                <!-- 密文结果 -->
                <Grid Grid.Row="1" Grid.Column="0" Margin="0,2,4,2">
                    <TextBox x:Name="textEncOutput" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="密文结果：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2,2,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image x:Name="imgCopyEncOutput" Source="{StaticResource IconCopy}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="复制密文结果"/>
                    <Image x:Name="imgPasteEncOutput" Source="{StaticResource IconPaste}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="粘贴密文结果"/>
                    <Image x:Name="imgClearEncOutput" Source="{StaticResource IconClear}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="清空密文结果"/>
                </StackPanel>

                <!-- 临时私钥 ePriv -->
                <Grid Grid.Row="2" Grid.Column="0" Margin="0,2,4,2">
                    <TextBox x:Name="textEncExtra" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="临时私钥ePriv：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,2,2,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image x:Name="imgCopyEncExtra" Source="{StaticResource IconCopy}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="复制临时私钥ePriv"/>
                    <Image x:Name="imgPasteEncExtra" Source="{StaticResource IconPaste}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="粘贴临时私钥ePriv"/>
                    <Image x:Name="imgClearEncExtra" Source="{StaticResource IconClear}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="清空临时私钥ePriv"/>
                </StackPanel>

                <!-- 临时公钥 ePub -->
                <Grid Grid.Row="3" Grid.Column="0" Margin="0,2,4,0">
                    <TextBox x:Name="textEncEphemeralPub" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="临时公钥ePub：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,2,2,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image x:Name="imgCopyEncEphemeralPub" Source="{StaticResource IconCopy}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="复制临时公钥ePub"/>
                    <Image x:Name="imgPasteEncEphemeralPub" Source="{StaticResource IconPaste}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="粘贴临时公钥ePub"/>
                    <Image x:Name="imgClearEncEphemeralPub" Source="{StaticResource IconClear}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="清空临时公钥ePub"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ==================== 中列：参数 ==================== -->
        <GroupBox Grid.Column="1" Header="参数" Margin="2,0,2,0">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>  <!-- 文本框 -->
                    <ColumnDefinition Width="24"/> <!-- 图标列（在 TextBox 外面右侧） -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="25*"/>
                </Grid.RowDefinitions>

                <!-- 对称密钥 -->
                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,4,2">
                    <TextBox x:Name="textEncKey" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="对称密钥：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,2,2,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image x:Name="imgCopyEncKey" Source="{StaticResource IconCopy}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="复制对称密钥"/>
                    <Image x:Name="imgPasteEncKey" Source="{StaticResource IconPaste}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="粘贴对称密钥"/>
                    <Image x:Name="imgClearEncKey" Source="{StaticResource IconClear}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="清空对称密钥"/>
                </StackPanel>

                <!-- 初始向量(IV) -->
                <Grid Grid.Row="1" Grid.Column="0" Margin="0,2,4,2">
                    <TextBox x:Name="textEncIV" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="初始向量(IV)：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2,2,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image x:Name="imgCopyEncIV" Source="{StaticResource IconCopy}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="复制初始向量(IV)"/>
                    <Image x:Name="imgPasteEncIV" Source="{StaticResource IconPaste}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="粘贴初始向量(IV)"/>
                    <Image x:Name="imgClearEncIV" Source="{StaticResource IconClear}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="清空初始向量(IV)"/>
                </StackPanel>

                <!-- Bob 公钥 -->
                <Grid Grid.Row="2" Grid.Column="0" Margin="0,2,4,2">
                    <TextBox x:Name="textEncBobPublic" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="Bob 公钥 (接收方)：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,2,2,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image x:Name="imgCopyEncBobPublic" Source="{StaticResource IconCopy}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="复制 Bob 公钥"/>
                    <Image x:Name="imgPasteEncBobPublic" Source="{StaticResource IconPaste}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="粘贴 Bob 公钥"/>
                    <Image x:Name="imgClearEncBobPublic" Source="{StaticResource IconClear}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="清空 Bob 公钥"/>
                </StackPanel>

                <!-- 测试 -->
                <Grid Grid.Row="3" Grid.Column="0" Margin="0,2,4,0">
                    <TextBox x:Name="textEncTest" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="测试：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,2,2,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image x:Name="imgCopyEncTest" Source="{StaticResource IconCopy}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="复制测试"/>
                    <Image x:Name="imgPasteEncTest" Source="{StaticResource IconPaste}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="粘贴测试"/>
                    <Image x:Name="imgClearEncTest" Source="{StaticResource IconClear}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0" ToolTip="清空测试"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ==================== 右列：操作与配置 ==================== -->
        <GroupBox Grid.Column="2" Header="操作-椭圆曲线集成加密方案" Margin="2,0,0,0">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/> <!-- 左：操作按钮 -->
                    <ColumnDefinition Width="*"/>   <!-- 右：配置 -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="50*"/>
                    <RowDefinition Height="50*"/>
                </Grid.RowDefinitions>

                <!-- 左列：操作按钮组（加密/解密/清空/密文拼接标准 + 一键复制密钥对） -->
                <Grid Grid.Column="0" Grid.RowSpan="7" Margin="0,0,5,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/> <!-- 吸收剩余空间 -->
                    </Grid.RowDefinitions>
                    <Button x:Name="btnEncrypt" Content="加密" Grid.Row="0" Height="30" VerticalAlignment="Center" Margin="0,0" Click="BtnEncrypt_Click"/>
                    <Button x:Name="btnDecrypt" Content="解密" Grid.Row="1" Height="30" VerticalAlignment="Center" Margin="0,0" Click="BtnDecrypt_Click"/>
                    <Button x:Name="btnEncClear" Content="清空" Grid.Row="2" Height="30" VerticalAlignment="Center" Margin="0,0" Click="BtnEncClear_Click"/>
                    <Button x:Name="btnEncFormatInfo" Content="密文拼接标准" Grid.Row="3" Height="30" VerticalAlignment="Center" Margin="0,0" Click="BtnEncFormatInfo_Click"/>
                    <Button x:Name="btnCopyTopKeyPair" Content="一键复制密钥对" Grid.Row="4" Height="30" VerticalAlignment="Center" Margin="0,0" Foreground="Red" ToolTip="把顶部 ECDSA 私钥(PEM)写入下方 ePriv，公钥(PEM)写入 ePub" Click="BtnCopyTopKeyPair_Click"/>
                </Grid>

                <!-- 右列：第 1 行 —— 加密模式 -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="加密模式：" Width="120" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="comboEncMode" Width="360" IsReadOnly="True" VerticalAlignment="Center">
                        <ComboBoxItem Content="ECIES (ECDH+AES-GCM, SHA-256)"/>
                        <ComboBoxItem Content="ECIES (ECDH+AES-GCM, SHA-512)"/>
                        <ComboBoxItem Content="AES-256-GCM"/>
                        <ComboBoxItem Content="AES-256-CBC"/>
                        <ComboBoxItem Content="ChaCha20-Poly1305"/>
                    </ComboBox>
                </StackPanel>

                <!-- 右列：第 2 行 —— 明文格式 -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="明文格式：" Width="120" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="comboEncInputFormat" Width="140" IsReadOnly="True" VerticalAlignment="Center">
                        <ComboBoxItem Content="UTF-8文本"/>
                        <ComboBoxItem Content="Base64"/>
                        <ComboBoxItem Content="Hex"/>
                    </ComboBox>
                </StackPanel>

                <!-- 右列：第 3 行 —— 密文格式 -->
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="密文格式：" Width="120" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="comboEncOutputFormat" Width="140" IsReadOnly="True" VerticalAlignment="Center">
                        <ComboBoxItem Content="Base64"/>
                        <ComboBoxItem Content="Hex"/>
                    </ComboBox>
                </StackPanel>

                <!-- 右列：第 4 行 —— 临时密钥转换 -->
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="临时密钥：" Width="120" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="comboEncKeyConvert" Width="220" IsReadOnly="True" VerticalAlignment="Center">
                        <ComboBoxItem Content="临时公钥 → Base64"/>
                        <ComboBoxItem Content="临时公钥 → PEM"/>
                        <ComboBoxItem Content="临时私钥 → Base64"/>
                        <ComboBoxItem Content="临时私钥 → PEM"/>
                    </ComboBox>
                    <Button x:Name="btnEncKeyConvert" Content="转换" Width="60" Height="24" Margin="4,0,0,0" VerticalAlignment="Center" Click="BtnEncKeyConvert_Click"/>
                </StackPanel>

                <!-- 右列：第 5 行 —— info 参数 -->
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="info参数：" Width="120" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="textEncInfo" Width="360" Height="24" VerticalAlignment="Center" ToolTip="留空为无 info"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
