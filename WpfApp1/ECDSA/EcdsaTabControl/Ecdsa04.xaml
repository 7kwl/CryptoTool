<!--
    Ecdsa04.xaml — ECDSA 文件验签页面
     整体布局：三列
       ├─ 左列：验签结果区（验签状态 / 文件哈希值 / 签名信息 / 验签详情 4 行展示，仿 Ecdsa01 布局）
       ├─ 中列：文件验签区（选择原文件 + 签名文件 → 验签）
       └─ 右列：签名选项区（Hash 算法 / k 生成方式 / 签名格式 + 行业流程说明）

   行业做法（Hash-then-Sign，与 openssl dgst -sha256 -sign/-verify 语义一致）：
      签名 = ECDSA_sign( Hash(file) )，验签 = ECDSA_verify( Hash(file), sig )
      即对"文件内容"做摘要再签名，而非对摘要文本做签名。
      BouncyCastle 的 DigestSigner 内部即此流程，且支持流式分块，大文件不占内存。
-->
<UserControl x:Class="WpfApp1.ECDSA.EcdsaTabControl.Ecdsa04"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="1800"
             Background="White">

    <!-- ===== 根网格：三列 ===== -->
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*"/> <!-- 第 0 列：验签结果 -->
            <ColumnDefinition Width="30*"/> <!-- 第 1 列：文件验签 -->
            <ColumnDefinition Width="40*"/> <!-- 第 2 列：签名选项 -->
        </Grid.ColumnDefinitions>

        <!-- ==================== 第 1 列：密钥对 ==================== -->
        <GroupBox Grid.Column="1" Header="密钥对" MinHeight="220" Margin="2,0,2,0">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25*"/> <!-- 爱丽丝私钥 -->
                    <RowDefinition Height="25*"/> <!-- 爱丽丝公钥 -->
                    <RowDefinition Height="25*"/> <!-- 鲍勃私钥 -->
                    <RowDefinition Height="25*"/> <!-- 鲍勃公钥 -->
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>  <!-- 文本框 -->
                        <ColumnDefinition Width="24"/>  <!-- 图标 -->
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="textEcdhAlicePrivate" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="爱丽丝(Alice)的私钥(PEM)：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <Image x:Name="imgCopyEcdhAlicePrivate" Source="{StaticResource IconCopy}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,8,0,0" Cursor="Hand"/>
                        <Image x:Name="imgPasteEcdhAlicePrivate" Source="{StaticResource IconPaste}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand"/>
                        <Image x:Name="imgClearEcdhAlicePrivate" Source="{StaticResource IconClear}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>  <!-- 文本框 -->
                        <ColumnDefinition Width="24"/>  <!-- 图标 -->
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="textEcdhAlicePublic" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="爱丽丝(Alice)的公钥(PEM)：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <Image x:Name="imgCopyEcdhAlicePublic" Source="{StaticResource IconCopy}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,8,0,0" Cursor="Hand"/>
                        <Image x:Name="imgPasteEcdhAlicePublic" Source="{StaticResource IconPaste}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand"/>
                        <Image x:Name="imgClearEcdhAlicePublic" Source="{StaticResource IconClear}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>  <!-- 文本框 -->
                        <ColumnDefinition Width="24"/>  <!-- 图标 -->
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="textEcdhBobPrivate" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="鲍勃(Bob)的私钥(PEM)：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <Image x:Name="imgCopyEcdhBobPrivate" Source="{StaticResource IconCopy}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,8,0,0" Cursor="Hand"/>
                        <Image x:Name="imgPasteEcdhBobPrivate" Source="{StaticResource IconPaste}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand"/>
                        <Image x:Name="imgClearEcdhBobPrivate" Source="{StaticResource IconClear}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>  <!-- 文本框 -->
                        <ColumnDefinition Width="24"/>  <!-- 图标 -->
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="textEcdhBobPublic" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12" Padding="4,22,4,4"/>
                    <TextBlock Text="鲍勃(Bob)的公钥(PEM)：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <Image x:Name="imgCopyEcdhBobPublic" Source="{StaticResource IconCopy}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,8,0,0" Cursor="Hand"/>
                        <Image x:Name="imgPasteEcdhBobPublic" Source="{StaticResource IconPaste}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand"/>
                        <Image x:Name="imgClearEcdhBobPublic" Source="{StaticResource IconClear}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ==================== 第 0 列：验签结果区（4 行文本框，仿 Ecdsa01 布局） ==================== -->
        <GroupBox Grid.Column="0" Header="签名验签" Margin="0,0,2,0">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25*"/> <!-- 0: 验签状态 -->
                    <RowDefinition Height="25*"/> <!-- 1: Hash 算法 -->
                    <RowDefinition Height="25*"/> <!-- 2: 签名信息 -->
                    <RowDefinition Height="25*"/> <!-- 3: 验签详情 -->
                </Grid.RowDefinitions>

                <!-- 第 0 行：文件签名 -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>  <!-- 文本框 -->
                        <ColumnDefinition Width="Auto"/>  <!-- 操作按钮 -->
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="textVerifyResult" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch"
                             BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12"
                             Padding="4,22,4,4" Background="#FFFBFBFB" Text="请导入文件或拖入文件到这里"/>
                    <TextBlock Text="文件签名：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Center">
                        <Button x:Name="btnSelectSignFile" Content="选择签名文件" Height="24" Margin="0,8,0,0" Padding="6,0" FontSize="11"/>
                        <Button x:Name="btnSignFile" Content="开始签名" Height="24" Margin="0,8,0,0" Padding="6,0" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- 第 1 行：文件验签 -->
                <Grid Grid.Row="1" Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>  <!-- 文本框 -->
                        <ColumnDefinition Width="Auto"/>  <!-- 图标 + 按钮 -->
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="textVerifyHash" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch"
                             BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12"
                             Padding="4,22,4,4" Background="#FFFBFBFB" Text=""/>
                    <TextBlock Text="文件验签：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Center">
                        <Image x:Name="imgCopyVerifyHash" Source="{StaticResource IconCopy}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,8,0,0" Cursor="Hand"/>
                        <Image x:Name="imgExportVerifyHash" Source="{StaticResource IconExport}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,8,0,0" Cursor="Hand"/>
                        <Button x:Name="btnSelectVerifyFileForHash" Content="选择验签文件..." Height="24" Margin="0,8,0,0" Padding="6,0" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <!-- 第 2 行：签名信息 -->
                <Grid Grid.Row="2" Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>  <!-- 文本框 -->
                        <ColumnDefinition Width="Auto"/>  <!-- 图标 + 按钮 -->
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="textVerifySigInfo" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch"
                             BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12"
                             Padding="4,22,4,4" Background="#FFFBFBFB" Text=""/>
                    <TextBlock Text="签名信息：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Center">
                        <Image x:Name="imgCopyVerifySigInfo" Source="{StaticResource IconCopy}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,8,0,0" Cursor="Hand"/>
                        <Button x:Name="btnSelectSigFileForInfo" Content="选择签名文件..." Height="24" Margin="0,8,0,0" Padding="6,0" FontSize="11"/>
                        <Button x:Name="btnVerifyHashAndSig" Content="开始验签" Height="24" Margin="0,8,0,0" Padding="6,0" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="textLeftVerifyResult" TextWrapping="Wrap" Width="80" FontSize="11" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 第 3 行：验签详情 -->
                <Grid Grid.Row="3" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>  <!-- 文本框 -->
                        <ColumnDefinition Width="Auto"/>  <!-- 图标 + 导出按钮 -->
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="textVerifyDetail" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch"
                             BorderBrush="#FFCCCCCC" FontFamily="Consolas" FontSize="12"
                             Padding="4,22,4,4" Background="#FFFBFBFB" Text=""/>
                    <TextBlock Text="验签详情：" Margin="4,4,0,0" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Center">
                        <Image x:Name="imgCopyVerifyDetail" Source="{StaticResource IconCopy}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,8,0,0" Cursor="Hand"/>
                        <Button x:Name="btnExportSignature" Content="导出签名sig" Height="24" Margin="0,8,0,0" Padding="6,0" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ==================== 第 2 列：签名选项区 ==================== -->
        <GroupBox Grid.Column="2" Header="签名选项" Margin="2,0,0,0">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*"/>   <!-- 0: 选项内容 -->
                    <ColumnDefinition Width="40*"/> <!-- 1: 操作按钮列 -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Hash 算法 -->
                    <RowDefinition Height="Auto"/> <!-- 1: k 生成方式 -->
                    <RowDefinition Height="Auto"/> <!-- 2: 签名格式 -->
                    <RowDefinition Height="Auto"/> <!-- 3: 分隔线 -->
                    <RowDefinition Height="*"/>    <!-- 4: 行业流程说明 -->
                </Grid.RowDefinitions>

                <!-- 第 0 行：Hash 算法 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,0,8">
                    <TextBlock Text="Hash 算法：" Width="100" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="comboHashAlgorithm" Width="240" IsReadOnly="True" VerticalAlignment="Center">
                        <ComboBoxItem Content="SHA-224"/>
                        <ComboBoxItem Content="SHA-256"/>
                        <ComboBoxItem Content="SHA-384"/>
                        <ComboBoxItem Content="SHA-512"/>
                        <ComboBoxItem Content="SHA3-224"/>
                        <ComboBoxItem Content="SHA3-256"/>
                        <ComboBoxItem Content="SHA3-384"/>
                        <ComboBoxItem Content="SHA3-512"/>
                    </ComboBox>
                </StackPanel>

                <!-- 第 1 行：k 生成方式 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,8">
                    <TextBlock Text="k 生成方式：" Width="100" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="comboKGeneration" Width="240" IsReadOnly="True" VerticalAlignment="Center">
                        <ComboBoxItem Content="混合熵随机 k（默认）">
                            <ComboBoxItem.ToolTip>
                                <TextBlock Text="RFC 6979 with additional entropy / Hybrid deterministic ECDSA" Foreground="Red"/>
                            </ComboBoxItem.ToolTip>
                        </ComboBoxItem>
                        <ComboBoxItem Content="RFC 6979 确定性 k">
                            <ComboBoxItem.ToolTip>
                                <TextBlock Text="Deterministic ECDSA (RFC 6979)" Foreground="Red"/>
                            </ComboBoxItem.ToolTip>
                        </ComboBoxItem>
                        <ComboBoxItem Content="纯 CSPRNG 随机 k">
                            <ComboBoxItem.ToolTip>
                                <TextBlock Text="Randomized ECDSA（概率型 ECDSA）" Foreground="Red"/>
                            </ComboBoxItem.ToolTip>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- 第 2 行：签名格式 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,8">
                    <TextBlock Text="签名格式：" Width="100" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="comboSignatureFormat" Width="240" IsReadOnly="True" VerticalAlignment="Center">
                        <ComboBoxItem Content="Base64">
                            <ComboBoxItem.ToolTip>
                                <TextBlock Text="DER 字节的 Base64 编码" Foreground="Red"/>
                            </ComboBoxItem.ToolTip>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Hex">
                            <ComboBoxItem.ToolTip>
                                <TextBlock Text="DER 字节的十六进制字符串" Foreground="Red"/>
                            </ComboBoxItem.ToolTip>
                        </ComboBoxItem>
                        <ComboBoxItem Content="DER（二进制）">
                            <ComboBoxItem.ToolTip>
                                <TextBlock Text="原始 ASN.1 DER 字节，.sig 保存为二进制" Foreground="Red"/>
                            </ComboBoxItem.ToolTip>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- 第 3 行：分隔线 -->
                <Separator Grid.Row="3" Margin="4,2,4,8"/>

                <!-- 第 4 行：行业流程说明 -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="行业流程（Hash-then-Sign，同 OpenSSL dgst）：" FontWeight="Bold" Foreground="#FF444444" TextWrapping="Wrap"/>
                        <TextBlock x:Name="textIndustryFlow" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20" Foreground="Transparent">
                            <Run Text="1. 对文件内容流式计算摘要（默认 SHA-256）；"/><LineBreak/>
                            <Run Text="2. 用顶部面板私钥对摘要做 ECDSA 签名；"/><LineBreak/>
                            <Run Text="3. 输出 ASN.1 DER 签名（.sig 文件）；"/><LineBreak/>
                            <Run Text="4. 验签方用公钥校验 Hash(file) 与签名是否匹配。"/><LineBreak/>
                            <Run Text="· 大文件采用 64KB 分块流式处理，不一次性读入内存；"/><LineBreak/>
                            <Run Text="· 验签时签名文件自动识别 Hex / Base64 / DER 二进制；"/><LineBreak/>
                            <Run Text="· 验签的 Hash 算法与 k 生成方式必须和签名时一致（与 openssl dgst 相同）。"/>
                        </TextBlock>
                        <Button x:Name="btnIndustryFlow" Content="行业流程" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,2" FontSize="11">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="Transparent"/>
                                    <Setter Property="Background" Value="#FFF0F0F0"/>
                                    <Setter Property="BorderBrush" Value="#FFD0D0D0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="Background" Value="#FFE0E0E0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 右侧操作按钮列 -->
                <StackPanel Grid.Column="1" Grid.RowSpan="5" Margin="10,2,0,0">
                    <TextBlock Text="验签操作" FontWeight="Bold" Foreground="#FF444444" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <Button x:Name="btnSideVerifyFile" Content="选择原文件" Height="32" Margin="0,0,0,6"/>
                    <Button x:Name="btnSideVerifySig" Content="选择签名文件" Height="32" Margin="0,0,0,6"/>
                    <Button x:Name="btnSideVerify" Content="开始验签" Height="32" Margin="0,0,0,6" FontWeight="Bold"/>
                    <Button x:Name="btnSideClear" Content="清空结果" Height="32" Margin="0,0,0,6"/>
                    <Separator Margin="4,4,4,8"/>
                    <TextBlock Text="签名格式影响导出/显示，验签自动识别。" FontSize="11" Foreground="#FF888888" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
