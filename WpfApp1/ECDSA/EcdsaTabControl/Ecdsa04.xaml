<!--
    Ecdsa04.xaml — ECDSA 文件签名/验签页面（对标行业 OpenSSL dgst / PGP 文件签名流程）
     整体布局：三列
       ├─ 左列：文件签名区（选择文件 → 文件信息/哈希 → 生成签名 → 预览/另存 .sig）
       ├─ 中列：文件验签区（选择原文件 + 签名文件 → 验签 → 结果展示）
       └─ 右列：签名选项区（Hash 算法 / k 生成方式 / 签名格式 + 行业流程说明）

    行业做法（Hash-then-Sign，与 openssl dgst -sha256 -sign/-verify 语义一致）：
      签名 = ECDSA_sign( Hash(file) )，验签 = ECDSA_verify( Hash(file), sig )
      即对"文件内容"做摘要再签名，而非对摘要文本做签名。
      BouncyCastle 的 DigestSigner 内部即此流程，且支持流式分块，大文件不占内存。
-->
<UserControl x:Class="WpfApp1.ECDSA.EcdsaTabControl.Ecdsa04"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="1800"
             Background="White">

    <!-- ===== 根网格：三列 ===== -->
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46*"/> <!-- 左列：文件签名 -->
            <ColumnDefinition Width="46*"/> <!-- 中列：文件验签 -->
            <ColumnDefinition Width="420"/> <!-- 右列：签名选项 -->
        </Grid.ColumnDefinitions>

        <!-- ==================== 左列：文件签名区 ==================== -->
        <GroupBox Grid.Column="0" Header="文件签名" Margin="0,0,2,0">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: 选择/另存按钮 -->
                    <RowDefinition Height="Auto"/> <!-- 1: 文件信息 -->
                    <RowDefinition Height="86"/>   <!-- 2: 文件哈希 -->
                    <RowDefinition Height="*"/>    <!-- 3: 签名预览 -->
                    <RowDefinition Height="Auto"/> <!-- 4: 生成签名按钮 -->
                </Grid.RowDefinitions>

                <!-- 第 0 行：选择文件 + 另存签名文件 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="btnSelectFile" Content="选择要签名的文件..." Height="30" MinWidth="170" VerticalAlignment="Center"/>
                    <Button x:Name="btnSaveSignature" Content="另存签名文件 (.sig)" Height="30" MinWidth="140" VerticalAlignment="Center" Margin="8,0,0,0" IsEnabled="False"/>
                </StackPanel>

                <!-- 第 1 行：文件信息（只读） -->
                <TextBox x:Name="textFileInfo" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         MinHeight="58" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC"
                         FontFamily="Consolas" FontSize="12" Padding="4,2,4,2" Background="#FFF7F7F7"
                         Foreground="#FF333333" Margin="0,0,0,4"
                         Text="请选择要签名的文件，将显示文件信息与 SHA-256 哈希。"/>

                <!-- 第 2 行：文件哈希（SHA-256，只读 + 复制） -->
                <Grid Grid.Row="2" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,4,0">
                        <TextBox x:Name="textFileHash" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC"
                                 FontFamily="Consolas" FontSize="12" Padding="4,18,4,4" Background="White"/>
                        <TextBlock Text="文件哈希 SHA-256：" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,3,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Image x:Name="imgCopyFileHash" Source="{StaticResource IconCopy}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 第 3 行：签名预览（只读 + 复制/清空） -->
                <Grid Grid.Row="3" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,4,0">
                        <TextBox x:Name="textSignature" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC"
                                 FontFamily="Consolas" FontSize="12" Padding="4,18,4,4" Background="White"
                                 Text="（尚未生成签名）"/>
                        <TextBlock Text="签名预览（按所选格式）：" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,3,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Image x:Name="imgCopySignature" Source="{StaticResource IconCopy}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0"/>
                        <Image x:Name="imgClearSignature" Source="{StaticResource IconClear}" Width="16" Height="16" Cursor="Hand" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 第 4 行：生成签名按钮 -->
                <Button x:Name="btnSign" Grid.Row="4" Content="对文件生成签名" Height="34" FontWeight="Bold"/>
            </Grid>
        </GroupBox>

        <!-- ==================== 中列：文件验签区 ==================== -->
        <GroupBox Grid.Column="1" Header="文件验签" Margin="2,0,2,0">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: 选择文件按钮 -->
                    <RowDefinition Height="Auto"/> <!-- 1: 路径信息 -->
                    <RowDefinition Height="110"/>  <!-- 2: 签名内容预览 -->
                    <RowDefinition Height="Auto"/> <!-- 3: 验签按钮 -->
                    <RowDefinition Height="*"/>    <!-- 4: 验签结果 -->
                </Grid.RowDefinitions>

                <!-- 第 0 行：选择原文件 + 签名文件 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="btnSelectVerifyFile" Content="选择原文件..." Height="30" MinWidth="150" VerticalAlignment="Center"/>
                    <Button x:Name="btnSelectVerifySig" Content="选择签名文件..." Height="30" MinWidth="150" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- 第 1 行：路径信息（只读） -->
                <TextBox x:Name="textVerifyPaths" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         MinHeight="44" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC"
                         FontFamily="Consolas" FontSize="12" Padding="4,2,4,2" Background="#FFF7F7F7"
                         Foreground="#FF333333" Margin="0,0,0,4"
                         Text="请选择原始文件与签名文件。验签时 Hash 算法 / k 生成方式必须与签名时一致（右侧选项区）。"/>

                <!-- 第 2 行：签名内容预览（只读 + 复制） -->
                <Grid Grid.Row="2" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,4,0">
                        <TextBox x:Name="textVerifySigPreview" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC"
                                 FontFamily="Consolas" FontSize="12" Padding="4,18,4,4" Background="White"/>
                        <TextBlock Text="签名内容预览：" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,3,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Image x:Name="imgCopyVerifySig" Source="{StaticResource IconCopy}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 第 3 行：验签按钮 -->
                <Button x:Name="btnVerify" Grid.Row="3" Content="开始验签" Height="34" FontWeight="Bold" Margin="0,0,0,4"/>

                <!-- 第 4 行：验签结果（只读 + 复制） -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,4,0">
                        <TextBox x:Name="textVerifyResult" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" BorderBrush="#FFCCCCCC"
                                 FontFamily="Consolas" FontSize="14" Padding="4,22,4,4" Background="#FFFBFBFB"
                                 Text="验签结果将在此显示。"/>
                        <TextBlock Text="验签结果：" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,3,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Image x:Name="imgCopyVerifyResult" Source="{StaticResource IconCopy}" Width="16" Height="16" Cursor="Hand" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ==================== 右列：签名选项区 ==================== -->
        <GroupBox Grid.Column="2" Header="签名选项" Margin="2,0,0,0">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Hash 算法 -->
                    <RowDefinition Height="Auto"/> <!-- 1: k 生成方式 -->
                    <RowDefinition Height="Auto"/> <!-- 2: 签名格式 -->
                    <RowDefinition Height="Auto"/> <!-- 3: 分隔线 -->
                    <RowDefinition Height="*"/>    <!-- 4: 行业流程说明 -->
                </Grid.RowDefinitions>

                <!-- 第 0 行：Hash 算法 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,0,8">
                    <TextBlock Text="Hash 算法：" Width="100" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="comboHashAlgorithm" Width="240" IsReadOnly="True" VerticalAlignment="Center">
                        <ComboBoxItem Content="SHA-224"/>
                        <ComboBoxItem Content="SHA-256"/>
                        <ComboBoxItem Content="SHA-384"/>
                        <ComboBoxItem Content="SHA-512"/>
                        <ComboBoxItem Content="SHA3-224"/>
                        <ComboBoxItem Content="SHA3-256"/>
                        <ComboBoxItem Content="SHA3-384"/>
                        <ComboBoxItem Content="SHA3-512"/>
                    </ComboBox>
                </StackPanel>

                <!-- 第 1 行：k 生成方式 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,8">
                    <TextBlock Text="k 生成方式：" Width="100" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="comboKGeneration" Width="240" IsReadOnly="True" VerticalAlignment="Center">
                        <ComboBoxItem Content="混合熵随机 k（默认）">
                            <ComboBoxItem.ToolTip>
                                <TextBlock Text="RFC 6979 with additional entropy / Hybrid deterministic ECDSA" Foreground="Red"/>
                            </ComboBoxItem.ToolTip>
                        </ComboBoxItem>
                        <ComboBoxItem Content="RFC 6979 确定性 k">
                            <ComboBoxItem.ToolTip>
                                <TextBlock Text="Deterministic ECDSA (RFC 6979)" Foreground="Red"/>
                            </ComboBoxItem.ToolTip>
                        </ComboBoxItem>
                        <ComboBoxItem Content="纯 CSPRNG 随机 k">
                            <ComboBoxItem.ToolTip>
                                <TextBlock Text="Randomized ECDSA（概率型 ECDSA）" Foreground="Red"/>
                            </ComboBoxItem.ToolTip>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- 第 2 行：签名格式 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,8">
                    <TextBlock Text="签名格式：" Width="100" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="comboSignatureFormat" Width="240" IsReadOnly="True" VerticalAlignment="Center">
                        <ComboBoxItem Content="Base64">
                            <ComboBoxItem.ToolTip>
                                <TextBlock Text="DER 字节的 Base64 编码" Foreground="Red"/>
                            </ComboBoxItem.ToolTip>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Hex">
                            <ComboBoxItem.ToolTip>
                                <TextBlock Text="DER 字节的十六进制字符串" Foreground="Red"/>
                            </ComboBoxItem.ToolTip>
                        </ComboBoxItem>
                        <ComboBoxItem Content="DER（二进制）">
                            <ComboBoxItem.ToolTip>
                                <TextBlock Text="原始 ASN.1 DER 字节，.sig 保存为二进制" Foreground="Red"/>
                            </ComboBoxItem.ToolTip>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- 第 3 行：分隔线 -->
                <Separator Grid.Row="3" Margin="4,2,4,8"/>

                <!-- 第 4 行：行业流程说明 -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="行业流程（Hash-then-Sign，同 OpenSSL dgst）：" FontWeight="Bold" Foreground="#FF444444" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20" Foreground="#FF666666">
                            <Run Text="1. 对文件内容流式计算摘要（默认 SHA-256）；"/><LineBreak/>
                            <Run Text="2. 用顶部面板私钥对摘要做 ECDSA 签名；"/><LineBreak/>
                            <Run Text="3. 输出 ASN.1 DER 签名（.sig 文件）；"/><LineBreak/>
                            <Run Text="4. 验签方用公钥校验 Hash(file) 与签名是否匹配。"/>
                        </TextBlock>
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20" Foreground="#FF888888">
                            <Run Text="· 大文件采用 64KB 分块流式处理，不一次性读入内存；"/><LineBreak/>
                            <Run Text="· 验签时签名文件自动识别 Hex / Base64 / DER 二进制；"/><LineBreak/>
                            <Run Text="· 验签的 Hash 算法与 k 生成方式必须和签名时一致（与 openssl dgst 相同）。"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
