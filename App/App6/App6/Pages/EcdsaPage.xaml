<Page x:Class="App6.Pages.EcdsaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      UseLayoutRounding="True">

  <Page.Resources>

    <Style x:Key="WinFormsBox" TargetType="TextBox">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="SimSun"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#888888"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="Padding" Value="3,2,3,2"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style x:Key="WinFormsBtn" TargetType="Button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="SimSun"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#888888"/>
      <Setter Property="Background" Value="#E1E1E1"/>
      <Setter Property="Padding" Value="10,3,10,3"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="UseSystemFocusVisuals" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="RootGrid"
                  Background="{TemplateBinding Background}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  CornerRadius="{TemplateBinding CornerRadius}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition To="Pressed"  GeneratedDuration="0"/>
                    <VisualTransition To="Normal"   GeneratedDuration="0"/>
                    <VisualTransition To="PointerOver" GeneratedDuration="0"/>
                    <VisualTransition To="Disabled" GeneratedDuration="0"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="RootGrid.Background" Value="#D0D0D0"/>
                      <Setter Target="RootGrid.BorderBrush" Value="#666666"/>
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="RootGrid.Background" Value="#C0C0C0"/>
                      <Setter Target="RootGrid.BorderBrush" Value="#555555"/>
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="RootGrid.Background" Value="#F0F0F0"/>
                      <Setter Target="Content.Foreground" Value="#A0A0A0"/>
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter x:Name="Content"
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WinFormsLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="SimSun"/>
      <Setter Property="Foreground" Value="Black"/>
    </Style>

    <Style x:Key="WinFormsCombo" TargetType="ComboBox">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="SimSun"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#888888"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="3,1"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="WinFormsRadio" TargetType="RadioButton">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="SimSun"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="MinHeight" Value="24"/>
    </Style>

  </Page.Resources>

  <Grid Background="White">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- 页面标题 -->
      <RowDefinition Height="Auto"/>   <!-- 主内容区 -->
      <RowDefinition Height="Auto"/>   <!-- 底部结果 -->
    </Grid.RowDefinitions>

    <!-- 页面标题 -->
    <TextBlock Grid.Row="0" Text="密钥生成"
               FontSize="12" FontFamily="SimSun"
               Foreground="Black"
               Margin="10,4,0,2"/>

    <!-- ====== 主内容区 ====== -->
    <Grid Grid.Row="1" Margin="10,2,10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3.5*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="2.5*"/>
      </Grid.ColumnDefinitions>

      <!-- 左列：私钥 + 公钥 PEM -->
      <StackPanel Grid.Column="0" Spacing="6">
        <!-- 私钥组 -->
        <Border BorderThickness="1" BorderBrush="#888888"
                Background="White" Padding="4">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="私钥 (PEM)："
                       HorizontalAlignment="Right"
                       Style="{StaticResource WinFormsLabel}"
                       Foreground="Red" FontWeight="Bold"
                       Margin="0,0,0,2"/>
            <TextBox Grid.Row="1" x:Name="PrivateKeyBox"
                     Style="{StaticResource WinFormsBox}"
                     MinHeight="120" IsReadOnly="True"/>
          </Grid>
        </Border>

        <!-- 公钥组 -->
        <Border BorderThickness="1" BorderBrush="#888888"
                Background="White" Padding="4">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="公钥 (PEM)："
                       HorizontalAlignment="Right"
                       Style="{StaticResource WinFormsLabel}"
                       Foreground="Red" FontWeight="Bold"
                       Margin="0,0,0,2"/>
            <TextBox Grid.Row="1" x:Name="PublicKeyBox"
                     Style="{StaticResource WinFormsBox}"
                     MinHeight="120" IsReadOnly="True"/>
          </Grid>
        </Border>
      </StackPanel>

      <!-- 中列：操作按钮 -->
      <StackPanel Grid.Column="1" Spacing="2" Width="130" Margin="8,0,8,0">
        <TextBlock Text="私钥操作" Style="{StaticResource WinFormsLabel}"
                   Foreground="Red" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,2"/>
        <Button x:Name="CopyPrivBtn"  Content="复制私钥" Style="{StaticResource WinFormsBtn}" Width="118"/>
        <Button x:Name="PastePrivBtn" Content="粘贴私钥" Style="{StaticResource WinFormsBtn}" Width="118"/>
        <Button x:Name="ImportPrivBtn" Content="导入私钥" Style="{StaticResource WinFormsBtn}" Width="118"/>
        <Button x:Name="SavePrivBtn"  Content="保存私钥" Style="{StaticResource WinFormsBtn}" Width="118"/>
        <Button x:Name="ClearPrivBtn" Content="清空私钥" Style="{StaticResource WinFormsBtn}" Width="118"/>

        <TextBlock Text="公钥操作" Style="{StaticResource WinFormsLabel}"
                   Foreground="Blue" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10,0,2"/>
        <Button x:Name="CopyPubBtn"  Content="复制公钥" Style="{StaticResource WinFormsBtn}" Width="118"/>
        <Button x:Name="PastePubBtn" Content="粘贴公钥" Style="{StaticResource WinFormsBtn}" Width="118"/>
        <Button x:Name="ImportPubBtn" Content="导入公钥" Style="{StaticResource WinFormsBtn}" Width="118"/>
        <Button x:Name="SavePubBtn"  Content="保存公钥" Style="{StaticResource WinFormsBtn}" Width="118"/>
        <Button x:Name="ClearPubBtn" Content="清空公钥" Style="{StaticResource WinFormsBtn}" Width="118"/>
      </StackPanel>

      <!-- 右列：密钥操作 + 设置 -->
      <StackPanel Grid.Column="2" Spacing="6">
        <!-- 密钥操作组 -->
        <Border BorderThickness="1" BorderBrush="#888888"
                Background="White" Padding="8,6,8,6">
          <StackPanel Spacing="3">
            <TextBlock Text="密钥操作" Style="{StaticResource WinFormsLabel}"
                       FontWeight="Bold"/>
            <Button x:Name="GenerateKeyBtn" Content="生成密钥对" Style="{StaticResource WinFormsBtn}" Width="140"/>
            <Button x:Name="VerifyKeyBtn"   Content="验证密钥对" Style="{StaticResource WinFormsBtn}" Width="140"/>
            <Button x:Name="ExtractPubBtn"  Content="从私钥提取公钥" Style="{StaticResource WinFormsBtn}" Width="140"/>
            <Button x:Name="GetCurveBtn"    Content="获取私钥曲线类" Style="{StaticResource WinFormsBtn}" Width="140"/>
            <Button x:Name="ClearAllBtn"    Content="清空全部" Style="{StaticResource WinFormsBtn}" Width="140"/>

            <Border BorderThickness="0,1,0,0" BorderBrush="#999999"
                    Margin="0,6,0,4" Height="1"/>

            <!-- 输出格式 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="输出格式："
                         Style="{StaticResource WinFormsLabel}"
                         VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox Grid.Column="1" x:Name="OutputFormatBox"
                        Style="{StaticResource WinFormsCombo}" SelectedIndex="0">
                <ComboBoxItem Content="PEM"/>
                <ComboBoxItem Content="DER"/>
              </ComboBox>
            </Grid>

            <!-- 密钥类型 -->
            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="密钥类型："
                         Style="{StaticResource WinFormsLabel}"
                         VerticalAlignment="Center" Margin="0,0,6,0"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <RadioButton x:Name="PrivRadio" Content="私钥"
                             Style="{StaticResource WinFormsRadio}" IsChecked="True"/>
                <RadioButton x:Name="PubRadio"  Content="公钥"
                             Style="{StaticResource WinFormsRadio}"/>
              </StackPanel>
            </Grid>

            <!-- 椭圆曲线 -->
            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="椭圆曲线："
                         Style="{StaticResource WinFormsLabel}"
                         VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox Grid.Column="1" x:Name="CurveBox"
                        Style="{StaticResource WinFormsCombo}" SelectedIndex="0">
                <ComboBoxItem Content="NIST Curves (F) →"/>
                <ComboBoxItem Content="P-256 (secp256r1) - 128位安全"/>
                <ComboBoxItem Content="P-384 (secp384r1) - 192位安全"/>
                <ComboBoxItem Content="P-521 (secp521r1) - 256位安全"/>
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- ====== 底部结果区 ====== -->
    <Grid Grid.Row="2" Margin="10,6,10,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 计算结果 -->
      <Border Grid.Column="0" BorderThickness="1" BorderBrush="#888888"
              Background="White" Padding="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="计算结果" Style="{StaticResource WinFormsLabel}"
                     FontWeight="Bold" Margin="0,0,0,2"/>
          <TextBlock Grid.Row="1" x:Name="ComputeResultText"
                     Text="等待操作..."
                     FontSize="12" FontFamily="SimSun"
                     Foreground="Gray" TextWrapping="Wrap"
                     MinHeight="30"/>
        </Grid>
      </Border>

      <!-- 运行结果 -->
      <Border Grid.Column="1" BorderThickness="1" BorderBrush="#888888"
              Background="White" Padding="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="运行结果" Style="{StaticResource WinFormsLabel}"
                     FontWeight="Bold" Margin="0,0,0,2"/>
          <TextBlock Grid.Row="1" x:Name="RunResultText"
                     Text="验证结果: 未验证"
                     FontSize="12" FontFamily="SimSun"
                     Foreground="Gray" TextWrapping="Wrap"
                     MinHeight="30"/>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</Page>
